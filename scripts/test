#!/bin/sh
# Repository test entrypoint: the deterministic checks that do not need a
# JavaScript oracle checkout. Exits non-zero on the first failure.
#
# Rust checks (fmt, clippy, MSRV check, release test suite) run here when a
# cargo toolchain is already available on PATH (including relocated
# RUSTUP_HOME/CARGO_HOME homes); when the host has none, they are left to the
# exact-source `ci` workflow (quality + test-and-package jobs), which runs
# them on every non-docs commit, and this entrypoint says so explicitly
# instead of failing on a missing toolchain.
set -e
cd "$(dirname "$0")/.."
# Focused mode: the supervisor passes this candidate's changed paths in
# NM_CHANGED_FILES (one per line). When set, run only the checks exercising
# those paths; when unset, run the whole suite exactly as before.
changed_match() {
  printf '%s\n' "${NM_CHANGED_FILES-}" | tr -d '\r' | grep -E "$1" || true
}
if [ -n "${NM_CHANGED_FILES-}" ]; then
  # Generated-catalog consistency covers any generator, transpiler, contract,
  # generated or runtime source change.
  if [ -n "$(changed_match '^(scripts/|src/)')" ]; then
    PYTHONDONTWRITEBYTECODE=1 python3 scripts/generate_bundle.py --check
  fi
  # Python unit tests: run the modules that exercise the changed paths, plus
  # the sync/parity suite whenever generated or runtime behavior moved.
  modules=$(changed_match '^scripts/tests/test_[a-z_]+\.py$' | sed -E 's|^scripts/tests/||; s|\.py$||')
  if [ -n "$(changed_match '^(scripts/transpiler/|scripts/generate_bundle\.py|scripts/upstream-param-contract\.json|src/generated/|src/renderer\.rs)')" ]; then
    modules=$(printf '%s\n%s\n' "$modules" "$(changed_match '^scripts/tests/test_(cpu_sync|parity)\.py$' | sed -E 's|^scripts/tests/||; s|\.py$||')" | awk 'NF && !seen[$0]++')
  fi
  if [ -n "$modules" ]; then
    for module in $modules; do
      PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s scripts/tests -p "${module}.py"
    done
  fi
else
  PYTHONDONTWRITEBYTECODE=1 python3 scripts/generate_bundle.py --check
  PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s scripts/tests -p 'test_*.py'
fi
if ! command -v cargo >/dev/null 2>&1; then
  # Relocated rustup/cargo homes (exec-capable, persistent) when the default
  # PATH carries no toolchain: the configured homes, else the shared
  # NOISEMAKER_RUST_CACHE.
  if [ -n "${NOISEMAKER_RUST_CACHE:-}" ]; then
    export RUSTUP_HOME="${RUSTUP_HOME:-$NOISEMAKER_RUST_CACHE/rustup}"
    export CARGO_HOME="${CARGO_HOME:-$NOISEMAKER_RUST_CACHE/cargo}"
  fi
  if [ -n "${CARGO_HOME:-}" ]; then
    export PATH="$CARGO_HOME/bin:$PATH"
  fi
fi
# A writable probe: the home must exist (or be creatable) and accept writes.
writable_home() {
  { mkdir -p -- "$1" && touch -- "$1/.rw-probe" && rm -f -- "$1/.rw-probe"; } 2>/dev/null
}
# A rustup home must also be exec-capable: toolchain binaries run from it.
exec_capable_home() {
  { mkdir -p -- "$1" && printf '#!/bin/sh\n' > "$1/.exec-probe" && chmod 755 \
      "$1/.exec-probe" && "$1/.exec-probe" && rm -f -- "$1/.exec-probe"; } 2>/dev/null
}
if command -v cargo >/dev/null 2>&1; then
  # Some hosts ship read-only toolchain homes: /opt/rust/cargo cannot take
  # the crates.io index/cache writes, /opt/rust/rustup cannot install the
  # 1.85.0 MSRV toolchain, and a shared NOISEMAKER_RUST_CACHE can be read-only
  # too.
  # Probe the first usable home (the checkout itself is writable and
  # exec-capable) and relocate there; rust-toolchain.toml's components make
  # an auto-installed stable toolchain complete.
  if ! writable_home "${CARGO_HOME:-${HOME:-/root}/.cargo}" \
    || ! exec_capable_home "${RUSTUP_HOME:-${HOME:-/root}/.rustup}"; then
    for candidate in ${NOISEMAKER_RUST_CACHE:+"$NOISEMAKER_RUST_CACHE/cargo"} .cargo-home "${TMPDIR:-/tmp}/noisemaker-cargo"; do
      if writable_home "$candidate"; then
        export CARGO_HOME="$candidate"
        break
      fi
    done
    for candidate in ${NOISEMAKER_RUST_CACHE:+"$NOISEMAKER_RUST_CACHE/rustup"} .rustup-home "${TMPDIR:-/tmp}/noisemaker-rustup"; do
      if exec_capable_home "$candidate"; then
        export RUSTUP_HOME="$candidate"
        break
      fi
    done
    if command -v rustup >/dev/null 2>&1; then
      # A relocated home may lack the toolchains and components the checks
      # need; provision them exactly like the ci workflow does. Disable the
      # self-update check first: the running rustup may live on a read-only
      # volume, and its self-update probe would fail the install.
      rustup set auto-self-update disable 2>/dev/null || true
      rustup toolchain install stable --profile minimal --component rustfmt --component clippy
      rustup toolchain install 1.85.0 --profile minimal
    fi
  fi
  if [ -n "${NM_CHANGED_FILES-}" ] && [ -z "$(changed_match '^(src/|Cargo[.]toml$|Cargo[.]lock$|rust-toolchain[.]toml$)')" ]; then
    echo "changed paths touch no Rust sources; rust checks are enforced by the exact-source ci workflow"
  else
    cargo fmt --all -- --check
    cargo clippy --all-targets --all-features -- -D warnings
    cargo +1.85.0 check --all-targets --all-features
    cargo test --release --locked --all-features
  fi
else
  echo "cargo toolchain not found on this host; rust checks are enforced by the exact-source ci workflow (quality, test-and-package)"
fi
